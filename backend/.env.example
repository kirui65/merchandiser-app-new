# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Firebase Admin SDK (service account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Firebase Console > Storage bucket name (for example, <project>.appspot.com)
FIREBASE_STORAGE_BUCKET=

# M-Pesa Daraja API (Phase 3)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
DARAJA_CALLBACK_TOKEN=
DARAJA_ENV=sandbox

# Reconciliation (Phase 3)
RECONCILIATION_WINDOW_MINUTES=15
GEOFENCE_RADIUS_METERS=100
OUTLET_OVERDUE_DAYS=7

# Scheduled report emails (https://resend.com). The sender must use a domain
# verified in Resend, e.g. "Brandsphere Reports <reports@yourdomain.com>".
RESEND_API_KEY=
REPORT_EMAIL_FROM=
# Long random string; the scheduler sends it in the x-cron-secret header.
REPORTS_CRON_SECRET=
# Optional link shown in report emails.
DASHBOARD_URL=

# Optional manager dashboard AI assistant (Google AI Studio).
# Keep this key on the backend; never expose it through Vite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# CORS
ALLOWED_ORIGINS=http://localhost:5173
